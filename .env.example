# --- Production -------------------------------------------------------------
# A Postgres connection string. On Vercel, adding a database from the dashboard
# sets this for you and you do not need this file at all.
# POSTGRES_URL is also accepted, since some Vercel integrations set that name.
# DATABASE_URL=postgres://user:password@host:5432/soto_padel?sslmode=require

# Serverless runs many short-lived instances, so each one keeps the smallest
# pool it can and leans on the provider's pooled connection string. Raise this
# only on a host that runs one long-lived process.
# DATABASE_POOL_MAX=1

# --- Local development ------------------------------------------------------
# With no DATABASE_URL, the app runs Postgres in-process (PGlite) against this
# directory, so there is nothing to install and nothing to configure.
DATABASE_PATH=./data/postgres
